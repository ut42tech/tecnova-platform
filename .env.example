# =============================================================================
# tecnova-platform 環境変数サンプル
# =============================================================================
#
# このファイルは公開リポジトリにコミットされます。実際の値は記載しないでください。
# 実値は `.env.local` に書くか、本番では Wrangler Secrets / Vercel環境変数で管理。
#
# 実値設定方法:
#   - ローカル開発: このファイルをコピーして .env.local に名前変更し、値を埋める
#   - Cloudflare Workers (apps/api): `npx wrangler secret put <NAME>` で登録
#   - Vercel (apps/checkin, apps/admin): Vercelダッシュボードの環境変数で登録
#
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Cloudflare D1)
# -----------------------------------------------------------------------------
# D1 は wrangler.toml の [[d1_databases]] バインディング経由で apps/api から
# `c.env.DB` として参照するため、接続文字列は不要。
# データベース作成: `pnpm --filter @tecnova/api exec wrangler d1 create tecnova-db`
# 出力された database_id を apps/api/wrangler.toml に記入すること。

# -----------------------------------------------------------------------------
# Google Sheets API
# -----------------------------------------------------------------------------
# サービスアカウントのJSON鍵を **base64 エンコードした文字列** で設定する。
# 生 JSON を貼ると dotenv が `private_key` 内の `\n` を実改行に変換してしまい、
# Worker 側の `JSON.parse` が「Bad control character」で失敗するため。
# 生成: `base64 -i ~/path/to/service-account.json | tr -d '\n'`
GOOGLE_SERVICE_ACCOUNT_KEY=

# 学生側スプシ（バックエンド参照用）のスプレッドシートID
# URLの `https://docs.google.com/spreadsheets/d/{ここの部分}/edit` を抜き出し
GOOGLE_SHEETS_ID=

# -----------------------------------------------------------------------------
# Google Drive folder creation via Apps Script
# -----------------------------------------------------------------------------
# 事前登録アクティベート時に利用者別 Google Drive フォルダを作る GAS Web App。
# 本番は Wrangler Secrets、ローカルは apps/api/.dev.vars に設定する。
GAS_DRIVE_WEBHOOK_URL=
GAS_DRIVE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Better Auth (Google OAuth)
# -----------------------------------------------------------------------------
# Google Cloud Console の OAuth 2.0 クライアントID/Secret
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Better Auth のセッション署名用シークレット
# `openssl rand -base64 32` などで生成した32バイト以上のランダム文字列
BETTER_AUTH_SECRET=

# Better Auth のベースURL（API側のpublicドメイン）
# 開発: http://localhost:8787
# 本番: https://tecnova-api.<your-subdomain>.workers.dev
BETTER_AUTH_URL=

# 管理画面・受付アプリ・サイネージなど、API に cross-origin で来るフロントのオリジン許可リスト。
# カンマ区切り文字列。CORS と Better Auth の trustedOrigins の両方で参照される。
# 開発: http://localhost:3000,http://localhost:3001,http://localhost:3002
# 本番: https://<checkin-domain>,https://<admin-domain>,https://<signage-domain>
TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# YouTube Data API (apps/signage 動画プレイリスト)
# -----------------------------------------------------------------------------
# サイネージの GET /api/signage/playlist が playlistItems.list を叩くための APIキーと
# プレイリストID。APIキーは「YouTube Data API v3 限定」の制限を付与する（リファラ制限は
# 付けない＝サーバ側呼び出し）。本番は Wrangler Secrets、ローカルは apps/api/.dev.vars。
YOUTUBE_API_KEY=
YOUTUBE_PLAYLIST_ID=

# -----------------------------------------------------------------------------
# Frontend (Next.js apps)
# -----------------------------------------------------------------------------
# フロントから叩くAPIのベースURL
# 開発: http://localhost:8787
# 本番: https://tecnova-api.<your-subdomain>.workers.dev
NEXT_PUBLIC_API_URL=
